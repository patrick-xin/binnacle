{
  "name": "binnacle-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "refs": "node scripts/refs.mjs",
    "dsh:profile": "node scripts/profile.mjs",
    "upstream": "node scripts/upstream.mjs",
    "pin": "node scripts/pin.mjs",
    "build": "pnpm --filter binnacle run build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "typecheck": "tsc -p packages/binnacle/tsconfig.json --noEmit",
    "lint": "oxlint",
    "lint:commits": "commitlint --from origin/main --to HEAD",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check:paths": "node scripts/check-paths.mjs",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "check:citations": "node scripts/check-citations.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:pins": "node scripts/check-pins.mjs",
    "check:patch": "node scripts/check-patch.mjs",
    "check:peers": "node scripts/check-peers.mjs",
    "check:layers": "node scripts/check-layers.mjs",
    "check:jsdoc": "node scripts/check-jsdoc.mjs",
    "check:comments": "node scripts/check-comments.mjs",
    "check:notes": "node scripts/check-folder-notes.mjs",
    "check:words": "node scripts/check-words.mjs",
    "check:skills": "node scripts/check-skills.mjs",
    "map": "node scripts/map.mjs",
    "check:boot": "node scripts/check-boot.mjs",
    "check": "pnpm run check:paths && pnpm run check:placeholders && pnpm run check:citations && pnpm run check:links && pnpm run check:pins && pnpm run check:patch && pnpm run check:peers && pnpm run check:layers && pnpm run check:jsdoc && pnpm run check:comments && pnpm run check:notes && pnpm run check:words && pnpm run check:skills && pnpm run lint && pnpm run fmt:check && pnpm run typecheck",
    "test": "pnpm run check && node --test \"scripts/*.test.mjs\" && pnpm --filter binnacle test"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@deepseek-ai/cordis-plugin-include": "1.0.9",
    "@types/node": "24.19.0",
    "js-yaml": "4.3.1",
    "oxc-parser": "0.151.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.85.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
