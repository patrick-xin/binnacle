{
  "name": "binnacle-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "refs": "node scripts/refs.mjs",
    "lint": "oxlint",
    "lint:commits": "commitlint --from origin/main --to HEAD",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check:paths": "node scripts/check-paths.mjs",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "check:citations": "node scripts/check-citations.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:skills": "node scripts/check-skills.mjs",
    "task": "node scripts/task/task.mjs",
    "try": "node scripts/try.mjs",
    "typecheck": "pnpm --filter binnacle exec tsc -p tsconfig.json",
    "build": "pnpm --filter binnacle run build",
    "check:features": "node scripts/check-features.mjs",
    "check": "pnpm run check:paths && pnpm run check:placeholders && pnpm run check:citations && pnpm run check:links && pnpm run check:skills && pnpm run check:features && pnpm run lint && pnpm run fmt:check && pnpm run typecheck",
    "test": "pnpm run check && node --test --test-timeout=30000 \"scripts/**/*.test.mjs\" && pnpm --filter binnacle test"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "js-yaml": "4.3.1",
    "oxc-parser": "0.151.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.85.0"
  },
  "engines": {
    "node": ">=24"
  }
}
