{
  "name": "binnacle",
  "version": "0.0.0",
  "private": true,
  "description": "A terminal app for DeepSeek Harness, mounted as a dsh bundle.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugins/transcript": {
      "types": "./dist/plugins/transcript/index.d.ts",
      "default": "./dist/plugins/transcript/index.js"
    },
    "./plugins/transcript-view": {
      "types": "./dist/plugins/transcript-view/index.d.ts",
      "default": "./dist/plugins/transcript-view/index.js"
    },
    "./plugins/tool-cards": {
      "types": "./dist/plugins/tool-cards/index.d.ts",
      "default": "./dist/plugins/tool-cards/index.js"
    },
    "./plugins/composer": {
      "types": "./dist/plugins/composer/index.d.ts",
      "default": "./dist/plugins/composer/index.js"
    },
    "./plugins/commands": {
      "types": "./dist/plugins/commands/index.d.ts",
      "default": "./dist/plugins/commands/index.js"
    },
    "./plugins/status-line": {
      "types": "./dist/plugins/status-line/index.d.ts",
      "default": "./dist/plugins/status-line/index.js"
    },
    "./plugins/requests": {
      "types": "./dist/plugins/requests/index.d.ts",
      "default": "./dist/plugins/requests/index.js"
    },
    "./plugins/requests-view": {
      "types": "./dist/plugins/requests-view/index.d.ts",
      "default": "./dist/plugins/requests-view/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "NOTICE",
    "AUTHORING.md",
    "src"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml"
      ]
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "test": "node --test --test-timeout=30000 \"test/**/*.test.ts\""
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "commander": "15.0.0",
    "get-east-asian-width": "1.6.0",
    "marked": "18.0.11"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-cmdline": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-commands": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-scope": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-user-approval": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-tool-ask-user": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-user-questions": "0.2.1-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-agent-default-model": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-cmdline": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-commands": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-scope": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-user-approval": "0.2.1-alpha.1",
    "@types/node": "24.19.0",
    "@xterm/headless": "5.5.0",
    "typescript": "7.0.2",
    "@deepseek-ai/dsh-tool-ask-user": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-user-questions": "0.2.1-alpha.1"
  }
}
