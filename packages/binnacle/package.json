{
  "name": "binnacle",
  "version": "0.0.0",
  "private": true,
  "description": "A terminal surface for DeepSeek Harness, mounted as a dsh bundle and drawn with pi-tui.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugins/transcript": {
      "types": "./dist/plugins/transcript/index.d.ts",
      "default": "./dist/plugins/transcript/index.js"
    },
    "./plugins/composer": {
      "types": "./dist/plugins/composer/index.d.ts",
      "default": "./dist/plugins/composer/index.js"
    },
    "./plugins/status-line": {
      "types": "./dist/plugins/status-line/index.d.ts",
      "default": "./dist/plugins/status-line/index.js"
    },
    "./plugins/tool-cards": {
      "types": "./dist/plugins/tool-cards/index.d.ts",
      "default": "./dist/plugins/tool-cards/index.js"
    },
    "./plugins/trajectory": {
      "types": "./dist/plugins/trajectory/index.d.ts",
      "default": "./dist/plugins/trajectory/index.js"
    },
    "./plugins/theme": {
      "types": "./dist/plugins/theme/index.d.ts",
      "default": "./dist/plugins/theme/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./presets/*.patch.yml": "./presets/*.patch.yml"
  },
  "files": [
    "dist",
    "theme.schema.json",
    "skills",
    "cordis.patch.yml",
    "NOTICE",
    "presets/standard.patch.yml",
    "presets/ptc.patch.yml",
    "presets/minimal.patch.yml",
    "presets/cordis.patch.yml",
    "presets/author.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/standard.patch.yml",
        "./presets/ptc.patch.yml",
        "./presets/minimal.patch.yml",
        "./presets/cordis.patch.yml",
        "./presets/author.patch.yml"
      ]
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "pnpm run build && node --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@earendil-works/pi-tui": "0.99.1",
    "commander": "15.0.0"
  },
