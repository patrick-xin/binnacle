{
  "name": "binnacle",
  "version": "0.0.0",
  "private": true,
  "description": "A terminal surface for DeepSeek Harness, mounted as a dsh bundle and drawn with pi-tui.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "pnpm run build && node --test \"test/*.test.ts\""
  },
  "dependencies": {
    "@earendil-works/pi-tui": "0.87.1",
    "commander": "15.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-cmdline": "0.1.7-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/cordis-plugin-loader": "1.0.5",
    "@deepseek-ai/cosmokit": "1.8.5",
    "@deepseek-ai/dsh-cmdline": "0.1.7-rc.2",
    "@deepseek-ai/schemastery": "3.18.4"
  }
}
