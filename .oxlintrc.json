{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "node"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "import/no-cycle": "error",
    "import/no-default-export": "error"
  },
  "ignorePatterns": [".refs/**", "**/dist/**", "node_modules/**"]
}
