{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["unicorn", "oxc", "import", "node"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "import/no-cycle": "error",
    "import/no-default-export": "error",
    "unicorn/filename-case": [
      "error",
      {
        "case": "kebabCase"
      }
    ]
  },
  "overrides": [
    {
      "files": ["commitlint.config.mjs"],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      "files": [
        "packages/binnacle/src/terminal/utils.ts",
        "packages/binnacle/src/terminal/stdin-buffer.ts",
        "packages/binnacle/src/terminal/keys.ts",
        "packages/binnacle/src/terminal/keybindings.ts",
        "packages/binnacle/src/terminal/kill-ring.ts",
        "packages/binnacle/src/terminal/undo-stack.ts",
        "packages/binnacle/src/terminal/word-navigation.ts",
        "packages/binnacle/src/terminal/autocomplete.ts",
        "packages/binnacle/src/terminal/tui.ts",
        "packages/binnacle/src/terminal/components/editor.ts",
        "packages/binnacle/src/terminal/components/select-list.ts"
      ],
      "rules": {
        "no-shadow": "off",
        "no-unmodified-loop-condition": "off",
        "no-underscore-dangle": "off",
        "unicorn/no-array-sort": "off"
      }
    },
    {
      "files": ["packages/binnacle/**"],
      "rules": {
        "no-control-regex": "off"
      }
    }
  ],
  "ignorePatterns": [".refs/**", "**/dist/**", "node_modules/**"]
}
