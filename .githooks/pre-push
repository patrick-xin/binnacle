#!/bin/sh
# Every gate and every test before a push: CI runs by hand while the repository is private, so this is what stops a red branch reaching GitHub.
# An upstream mail branch is pushed by its job, which runs its own canary, so the hook stands aside when it runs there.
[ -n "$GITHUB_ACTIONS" ] && exit 0
# git hands a hook the repository it runs for, which a linked worktree names by GIT_DIR; left set, every git call the
# gates make in a reference under .refs/ reads this repository instead, and each citation is said to be at the wrong pin.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE
exec pnpm test
