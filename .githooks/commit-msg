#!/bin/sh
# A commit's header is Conventional Commits, held by commitlint.config.mjs; CI's jobs commit their own prose, so the hook stands aside there as pre-push does.
[ -n "$GITHUB_ACTIONS" ] && exit 0
pnpm exec commitlint --edit "$1" || exit 1
# A merge brings commits that answered for their own docs.
git rev-parse -q --verify MERGE_HEAD >/dev/null && exit 0
# A feature's code and its doc change together: the check reads the staged files with this message, before CI does.
exec node scripts/check-features.mjs --message "$1"
